# Copia este archivo como .env. Nunca subas la clave real.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/sentinel.db
ADMIN_TOKEN=replace-with-a-local-admin-token
CORS_ORIGINS=["http://127.0.0.1:5173"]

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

CHALLENGE_REMEDIATION_ENABLED=true
CHALLENGE_REMEDIATION_WAIT_SECONDS=300
CHALLENGE_REMEDIATION_VERIFICATION_MINUTES=10
MCP_EXECUTION_URL=http://127.0.0.1:8000/mcp-execution/
MCP_EXECUTION_TOKEN=
MCP_READ_TOKEN=
